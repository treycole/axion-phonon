+  !------------------------------------------------------------------------
+  SUBROUTINE init_paw_mag_delta()
+    !------------------------------------------------------------------------
+    !! Reads QE_PAW_MAG_DELTA (e/bohr^3) once. With delta > 0 the local-frame
+    !! noncollinear PAW GGA uses |m|**2/SQRT(|m|**2+delta**2) instead of |m|, which
+    !! removes the kink of |m| at m = 0 (error ~ delta**2/(2|m|) where |m| >> delta).
+    !
+    USE io_global, ONLY : stdout
+    !
+    CHARACTER(LEN=64) :: val
+    INTEGER :: ln, st
+    !
+    IF (paw_mag_delta >= 0.0_DP) RETURN
+    paw_mag_delta = 0.0_DP
+    CALL GET_ENVIRONMENT_VARIABLE( 'QE_PAW_MAG_DELTA', val, ln, st )
+    IF (st == 0 .AND. ln > 0) READ( val, * ) paw_mag_delta
+    WRITE( stdout, '(5x,"PAW noncollinear GGA: |m| regularization delta = ",ES10.3," e/bohr^3")' ) &
+         paw_mag_delta
+    !
+  END SUBROUTINE init_paw_mag_delta
